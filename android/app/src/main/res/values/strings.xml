    <string name="permissions_background_location_desc">Needed so sharing keeps working while the app isn\'t open. Choose \"Allow all the time\" on the next screen.</string>
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_desc">Needed to alert you about geofence and battery events.</string>
